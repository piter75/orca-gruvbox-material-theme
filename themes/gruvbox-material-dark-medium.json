{
  "base": "dark",
  "tokens": {
    "--background": "#282828",
    "--editor-surface": "#282828",
    "--foreground": "#d4be98",
    "--card": "#282828",
    "--card-foreground": "#d4be98",
    "--popover": "#282828",
    "--popover-foreground": "#d4be98",
    "--primary": "#d8a657",
    "--primary-foreground": "#282828",
    "--secondary": "#282828",
    "--secondary-foreground": "#d4be98",
    "--muted": "#282828",
    "--muted-foreground": "#a89984",
    "--accent": "#45403d",
    "--accent-foreground": "#d4be98",
    "--border": "#45403d",
    "--input": "#32302f",
    "--ring": "#d8a657",
    "--sidebar": "#282828",
    "--sidebar-foreground": "#d4be98",
    "--sidebar-accent": "#45403d",
    "--sidebar-accent-foreground": "#d4be98",
    "--sidebar-border": "#45403d",
    "--sidebar-ring": "#d8a657",
    "--worktree-sidebar": "#282828",
    "--worktree-sidebar-border": "#45403d",
    "--chart-1": "#d8a657",
    "--chart-2": "#a9b665",
    "--chart-3": "#7daea3",
    "--chart-4": "#d3869b",
    "--chart-5": "#e78a4e",
    "--tab-bar": "#282828",
    "--tab-active": "#282828",
    "--tab-active-foreground": "#d4be98",
    "--tab-active-indicator": "#d8a657",
    "--tab-inactive": "#282828",
    "--tab-inactive-foreground": "#a89984",
    "--split-divider": "#45403d",
    "--split-divider-hover": "#d8a657",
    "--text-link": "#7daea3",
    "--diff-added": "#a9b665",
    "--diff-removed": "#ea6962",
    "--git-decoration-added": "#a9b665",
    "--git-decoration-modified": "#d8a657",
    "--git-decoration-deleted": "#ea6962",
    "--git-decoration-renamed": "#7daea3",
    "--git-decoration-untracked": "#a9b665",
    "--git-decoration-copied": "#89b482",
    "--git-decoration-ignored": "#928374",
    "--diff-added-background": "#34381b",
    "--diff-removed-background": "#402120"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#7daea3"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#89b482"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Booleans",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#d8a657"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#d8a657"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#d4be98"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e78a4e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7daea3",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ea6962"
      }
    }
  ]
}
